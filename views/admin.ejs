<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>管理後台 | MAX 俱樂部</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <img src="/logo.png" class="logo-sm" onerror="this.style.display='none'">
      <span>MAX 管理後台</span>
    </div>
    <div class="role-badge">管理員</div>
    <button class="btn-logout" onclick="logout()">登出</button>
  </header>

  <div class="container">
    <div class="card">
      <div class="section-title" style="margin-top:0;">本月統計</div>
      <div id="stats">載入中...</div>
    </div>

    <div class="section-title">待驗證老闆</div>
    <div id="pendingList" class="card"><div class="empty">載入中...</div></div>

    <div class="section-title">新增打手</div>
    <div class="card">
      <div class="field"><label>手機號</label><input type="tel" id="pPhone" placeholder="0912345678"></div>
      <div class="field"><label>暱稱</label><input type="text" id="pName" placeholder="阿凱"></div>
      <div class="field"><label>密碼（預設 123456）</label><input type="text" id="pPass" placeholder="123456"></div>
      <button class="btn-primary btn-block" onclick="addPlayer()">新增打手</button>
    </div>

    <div class="section-title">所有訂單（最近）</div>
    <div id="orderList"><div class="empty">載入中...</div></div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    async function loadStats() {
      const res = await fetch('/api/admin/stats');
      const d = await res.json();
      document.getElementById('stats').innerHTML = `
        <div class="meta">月份：${d.month}</div>
        <div class="amount" style="font-size:18px;">完成金額 NT$ ${Number(d.completed_amount).toLocaleString()}</div>
        <div class="meta">總訂單 ${d.total_orders} 筆</div>
      `;
    }

    async function loadPending() {
      const res = await fetch('/api/admin/pending-users');
      const d = await res.json();
      const el = document.getElementById('pendingList');
      if (!d.users.length) {
        el.innerHTML = '<div class="empty">目前沒有待驗證老闆</div>';
        return;
      }
      el.innerHTML = d.users.map(u => `
        <div style="padding:10px 0;border-bottom:1px solid var(--border);">
          <div><strong>${u.name}</strong> · ${u.phone}</div>
          <div class="meta">註冊時間：${new Date(u.created_at).toLocaleString('zh-TW')}</div>
          <div style="margin-top:8px;">
            <button class="btn-sm btn-primary" onclick="genCode(${u.id})">產生驗證碼</button>
            ${u.verification_code ? `<span class="badge">目前碼：${u.verification_code}</span>` : ''}
          </div>
        </div>
      `).join('');
    }

    async function genCode(id) {
      const res = await fetch('/api/admin/generate-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: id })
      });
      const d = await res.json();
      if (!res.ok) return alert(d.error || '失敗');
      alert('驗證碼已產生：' + d.code + '\n請把這個碼給老闆輸入');
      loadPending();
    }

    async function addPlayer() {
      const phone = document.getElementById('pPhone').value.trim();
      const name = document.getElementById('pName').value.trim();
      const password = document.getElementById('pPass').value.trim() || '123456';
      if (!phone) return alert('請填手機號');
      const res = await fetch('/api/admin/add-player', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone, name, password })
      });
      const d = await res.json();
      if (!res.ok) return alert(d.error || '失敗');
      alert('打手已新增');
      document.getElementById('pPhone').value = '';
      document.getElementById('pName').value = '';
    }

    async function loadOrders() {
      const res = await fetch('/api/orders/my');
      const data = await res.json();
      const list = document.getElementById('orderList');
      if (!data.orders?.length) {
        list.innerHTML = '<div class="empty">尚無訂單</div>';
        return;
      }
      list.innerHTML = data.orders.slice(0, 30).map(o => `
        <div class="card">
          <div class="card-header">
            <div class="amount">NT$ ${o.amount.toLocaleString()}</div>
            <span class="status status-${o.status}">${o.status}</span>
          </div>
          <div class="meta">#${o.id} · ${o.product_name || ''} · 老闆：${o.boss_name || '-'} · 打手：${o.player_name || '-'}</div>
        </div>
      `).join('');
    }

    loadStats();
    loadPending();
    loadOrders();
    setInterval(() => { loadPending(); loadOrders(); }, 30000);
  </script>
</body>
</html>
