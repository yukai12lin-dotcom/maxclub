<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <title>打手工作台 | MAX 俱樂部</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <img src="/logo.png" class="logo-sm" onerror="this.style.display='none'">
      <span>MAX 俱樂部</span>
    </div>
    <div class="role-badge">打手</div>
    <button class="btn-logout" onclick="logout()">登出</button>
  </header>

  <div class="container">
    <div class="section-title">可接訂單 / 我的進行中</div>
    <div id="orderList"><div class="empty">載入中...</div></div>
  </div>

  <script src="/js/app.js"></script>
  <script>
    async function loadOrders() {
      const res = await fetch('/api/orders/my');
      const data = await res.json();
      const list = document.getElementById('orderList');
      if (!data.orders || data.orders.length === 0) {
        list.innerHTML = '<div class="empty">目前沒有可接或進行中的訂單</div>';
        return;
      }
      list.innerHTML = data.orders.map(o => {
        const st = statusText(o.status);
        const isMine = o.player_id; // simplified
        return `<div class="card ${o.is_urgent ? 'urgent' : ''}">
          <div class="card-header">
            <div class="amount">NT$ ${o.amount.toLocaleString()}</div>
            <span class="status status-${o.status}">${st}</span>
          </div>
          <div class="meta">${o.product_name || '代打'} · #${o.id}</div>
          <div class="meta">老闆：${o.boss_name || '-'}</div>
          ${o.scheduled_at ? `<div class="meta">約定：${formatTime(o.scheduled_at)}</div>` : ''}
          ${o.note ? `<div class="meta">備註：${o.note}</div>` : ''}
          <div class="actions">
            ${o.status === 'pending' ? `
              <button class="btn-sm btn-primary" onclick="acceptOrder(${o.id})">接單</button>
            ` : ''}
            ${o.status === 'accepted' ? `
              <button class="btn-sm btn-primary" onclick="enterRoom(${o.id})">已進房</button>
              <button class="btn-sm btn-outline" onclick="doAction(${o.id},'delay')">延後時間</button>
              <button class="btn-sm btn-outline" onclick="doAction(${o.id},'report')">回報問題</button>
              <button class="btn-sm btn-danger" onclick="doAction(${o.id},'cancel')">取消</button>
            ` : ''}
            ${o.status === 'in_room' ? `
              <button class="btn-sm btn-primary" onclick="completeOrder(${o.id})">上傳截圖結單</button>
              <button class="btn-sm btn-outline" onclick="doAction(${o.id},'report')">回報問題</button>
            ` : ''}
          </div>
        </div>`;
      }).join('');
    }

    function statusText(s) {
      const map = { pending: '待接單', accepted: '已接單', in_room: '已進房', completed: '已完成', cancelled: '已取消' };
      return map[s] || s;
    }
    function formatTime(t) {
      if (!t) return '';
      return new Date(t).toLocaleString('zh-TW', { month:'numeric', day:'numeric', hour:'2-digit', minute:'2-digit' });
    }

    async function acceptOrder(id) {
      if (!confirm('確認接這張單？')) return;
      const res = await fetch(`/api/orders/${id}/accept`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok) return alert(data.error || '接單失敗');
      loadOrders();
    }

    async function enterRoom(id) {
      const res = await fetch(`/api/orders/${id}/enter-room`, { method: 'POST' });
      if (!res.ok) return alert('操作失敗');
      loadOrders();
    }

    async function completeOrder(id) {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = async () => {
        if (!input.files[0]) return;
        const fd = new FormData();
        fd.append('screenshot', input.files[0]);
        const res = await fetch(`/api/orders/${id}/complete`, { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) return alert(data.error || '結單失敗');
        alert('結單成功！');
        loadOrders();
      };
      input.click();
    }

    async function doAction(id, action) {
      let reason = '', new_time = null;
      if (action === 'cancel' || action === 'report') reason = prompt(action === 'cancel' ? '取消原因' : '問題描述') || '';
      if (action === 'delay') {
        const t = prompt('新的約定時間（例如 2026-11-26 20:00）');
        if (t) new_time = t;
      }
      const res = await fetch(`/api/orders/${id}/action`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, reason, new_time })
      });
      const data = await res.json();
      if (!res.ok) return alert(data.error || '失敗');
      loadOrders();
    }

    loadOrders();
    setInterval(loadOrders, 20000);
  </script>
</body>
</html>
